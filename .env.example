# Optional SMTP alert settings
NDM_SMTP_HOST=smtp.example.net
NDM_SMTP_PORT=587
NDM_SMTP_USERNAME=monitor@example.net
NDM_SMTP_PASSWORD=replace-me
NDM_EMAIL_FROM=monitor@example.net
NDM_EMAIL_TO=operations@example.net
NDM_SMTP_STARTTLS=true

# Optional incident-ticket webhook settings
NDM_TICKET_WEBHOOK=https://tickets.example.net/api/incidents
NDM_TICKET_TOKEN=replace-me
